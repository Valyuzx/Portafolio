{
  "Serilog": {
    "using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore.Hosting.Diagnostics": "Error",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/log-.txt",
          "rollingInterval": "Day",
          "formatter": "Serilog.Formatting.Json.JsonFormatter, Serilog"
        }
      }
    ]
  },
  "ConnectionStrings": {
    "ApplicationDbContext": "Host=localhost;Port=5432;Database=DBPortafolio;Username=postgres;Password=postgres;"
  },
  "Jwt": {
    "Secret": "EstaEsUnaClaveSuperSecretaYMuyLargaQueTieneAlMenos64CaracteresDeLongitud1234567890",
    "Issuers": "https://localhost:5012",
    "Audience": "portfolio-client",
    "AccessTokenExpiryMinutes": 10,
    "RefreshTokenExpiryHours": 1
  }
}